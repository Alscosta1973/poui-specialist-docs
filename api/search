divinhe o tamanho."},"4002":{"id":"/docs/padroes/protheus-standard-fields-16","page_id":"/docs/padroes/protheus-standard-fields","tags":[],"type":"text","url":"/docs/padroes/protheus-standard-fields#o-que-cada-coluna-sx3-significa-para-interpretar-o-resultado","content":"Coluna SX3"},"4003":{"id":"/docs/padroes/protheus-standard-fields-17","page_id":"/docs/padroes/protheus-standard-fields","tags":[],"type":"text","url":"/docs/padroes/protheus-standard-fields#o-que-cada-coluna-sx3-significa-para-interpretar-o-resultado","content":"Significado"},"4004":{"id":"/docs/padroes/protheus-standard-fields-18","page_id":"/docs/padroes/protheus-standard-fields","tags":[],"type":"text","url":"/docs/padroes/protheus-standard-fields#o-que-cada-coluna-sx3-significa-para-interpretar-o-resultado","content":"`X3_CAMPO`"},"4005":{"id":"/docs/padroes/protheus-standard-fields-19","page_id":"/docs/padroes/protheus-standard-fields","tags":[],"type":"text","url":"/docs/padroes/protheus-standard-fields#o-que-cada-coluna-sx3-significa-para-interpretar-o-resultado","content":"Nome do campo (ex: `A1_COD`)"},"4006":{"id":"/docs/padroes/protheus-standard-fields-20","page_id":"/docs/padroes/protheus-standard-fields","tags":[],"type":"text","url":"/docs/padroes/protheus-standard-fields#o-que-cada-coluna-sx3-significa-para-interpretar-o-resultado","content":"`X3_TIPO`"},"4007":{"id":"/docs/padroes/protheus-standard-fields-21","page_id":"/docs/padroes/protheus-standard-fields","tags":[],"type":"text","url":"/docs/padroes/protheus-standard-fields#o-que-cada-coluna-sx3-significa-para-interpretar-o-resultado","content":"Tipo: `C` Character, `N` Numeric, `D` Date, `L` Logical, `M` Memo"},"4008":{"id":"/docs/padroes/protheus-standard-fields-22","page_id":"/docs/padroes/protheus-standard-fields","tags":[],"type":"text","url":"/docs/padroes/protheus-standard-fields#o-que-cada-coluna-sx3-significa-para-interpretar-o-resultado","content":"`X3_TAMANHO`"},"4009":{"id":"/docs/padroes/protheus-standard-fields-23"