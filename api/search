heme/css/po-theme-default.min.css\",\n>   \"node_modules/@po-ui/style/css/po-theme-core.min.css\",\n>   \"src/styles.scss\"\n> ]\n> ```"},"3313":{"id":"/docs/padroes/po-ui-patterns-dark-mode-23","page_id":"/docs/padroes/po-ui-patterns-dark-mode","tags":[],"type":"text","url":"/docs/padroes/po-ui-patterns-dark-mode#1-themeservice--singleton-com-persistência","content":"Encapsule `PoThemeService` em um service próprio que persiste a preferência no `localStorage`\ne detecta a preferência do sistema operacional na primeira visita:"},"3314":{"id":"/docs/padroes/po-ui-patterns-dark-mode-24","page_id":"/docs/padroes/po-ui-patterns-dark-mode","tags":[],"type":"text","url":"/docs/padroes/po-ui-patterns-dark-mode#2-toggle-no-appcomponent","content":"> **Ícone reativo:** para alternar o ícone conforme o modo atual, use `computed()`:\n>\n> ```typescript\n> readonly themeIcon = computed(() =>\n>   this.themeService.mode() === 'dark' ? 'po-icon-light' : 'po-icon-moon'\n> );\n> ```\n>\n> E referencie `themeIcon()` no `icon` da ação. Como `PoToolbarAction` é um array\n> estático, use um método que o recria quando o signal muda — ou use um `<po-button>` dedicado."},"3315":{"id":"/docs/padroes/po-ui-patterns-dark-mode-25","page_id":"/docs/padroes/po-ui-patterns-dark-mode","tags":[],"type":"text","url":"/docs/padroes/po-ui-patterns-dark-mode#3-toggle-como-po-button-dedicado-alternativa-simples","content":"Quando a toolbar já está ocupada, um botão flutuante ou no menu lateral:"},"3316":{"id":"/docs/padroes/po-ui-patterns-dark-mode-26","page_id":"/docs/padroes/po-ui-patterns-dark-mode","tags":[],"type":"text","url":"/docs/padroes/po-ui-patterns-dark-mode#4-detectar-mudança-de-preferência-do-sistema-em-tempo-real","content":"Se o usuário mudar a preferência do SO (ex: ligar dark mode automático ao anoitecer)\nsem interagir com o app, detecte automaticamente:"},"3317":{"id":"/docs/padroes/po-ui-patterns-dark-mode-27","page_id":"/docs/padroes/po-ui-patterns-dark-mode","tags":[],"type":"te